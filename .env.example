# Ranking data source: "mock" (no key, deterministic model) or "google" (live scans)
RANKING_PROVIDER=mock
NEXT_PUBLIC_RANKING_PROVIDER=mock

# Required only when RANKING_PROVIDER=google
# Google Maps Platform key with "Places API (New)" enabled
GOOGLE_MAPS_API_KEY=

# Scan tuning
SCAN_RADIUS_M=2000
GRID_STEP_DEG=0.0075
